# Copy this file to a private tenant env file outside the Git repository.
# Generate unique database passwords for every tenant. Never reuse passwords.
MAUTIC_IMAGE=wallzaos/mautic:7.2.2-wallza1
MAUTIC_HTTP_BIND=127.0.0.1
MAUTIC_HTTP_PORT=8080

MARIADB_DATABASE=mautic
MARIADB_USER=mautic
MARIADB_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET
MARIADB_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET

# Initial resource caps for a small pilot tenant on a shared 2-vCPU / 12-GB host.
# These are starting limits, not a capacity guarantee. Measure before adding tenants.
MAUTIC_DB_MEMORY_LIMIT=2g
MAUTIC_WEB_MEMORY_LIMIT=2g
MAUTIC_CRON_MEMORY_LIMIT=512m
MAUTIC_WORKER_MEMORY_LIMIT=1g
MAUTIC_DB_CPUS=0.45
MAUTIC_WEB_CPUS=0.65
MAUTIC_CRON_CPUS=0.15
MAUTIC_WORKER_CPUS=0.45

MAILPIT_WEB_PORT=8025

# One consumer per queue for the initial 2-vCPU pilot; increase only after load tests.
MAUTIC_WORKERS_CONSUME_EMAIL=1
MAUTIC_WORKERS_CONSUME_HIT=1
MAUTIC_WORKERS_CONSUME_FAILED=1

# WallzaOS SSO is disabled until the tenant ID, public HTTPS endpoints,
# canonical Mautic base URL and per-tenant HMAC secret are configured.
# The provisioner generates WALLZA_SSO_HMAC_SECRET automatically.
WALLZA_MAUTIC_TENANT_ID=
WALLZA_MAUTIC_BASE_URL=
WALLZA_SSO_AUTHORIZE_URL=
WALLZA_SSO_TOKEN_URL=
WALLZA_SSO_ISSUER=https://api.wallza.in
WALLZA_SSO_HMAC_SECRET=
